# Copy to agentic/.env and chmod 600; never commit the copy. scripts/run_one.sh and core/meta_harness.py
# read it, and it is not copied into run checkouts.

# Required: Claude Code OAuth token of an account that can use claude-opus-5.
CLAUDE_CODE_OAUTH_TOKEN=

# The endpoint is recorded in each new run's config. The key is read only at runtime;
# configs record solver.api_key_env, never its value. Leave the key empty for a local solver without auth.
AGENTIC_SOLVER_API_BASE=
AGENTIC_SOLVER_API_KEY=

# Optional.
# PREFLIGHT_CLAUDE_VERSION=   Claude Code version expected in the proposer image (default: the host's `claude --version`)
# AGENTIC_SANDBOX_UID=        sandbox user and group when the host user is root (default 1000)
# AGENTIC_SANDBOX_GID=
# APPWORLD_CLI=               appworld CLI used by scripts/appworld_data_setup.sh (default .venv/bin/appworld)
# APPWORLD_SKIP_VERIFY=       set to 1 to skip `appworld verify tasks`
