# Copy to text_classification/.env and chmod 600; never commit the copy. Each run works in a copy of this folder that
# the proposer container mounts, so the copy must not contain .env (see the README); load this file from here with
# `set -a; . text_classification/.env; set +a` after setting RUN. meta_harness.py refuses to start the proposer while
# a .env file is inside the mounted checkout.

# Required: Claude Code OAuth token of an account that can use claude-opus-5.
CLAUDE_CODE_OAUTH_TOKEN=

TEXT_PROPOSER_IMAGE=text-proposer:v1
TEXT_PROPOSER_HOME=$RUN/proposer-home
TEXT_PROPOSER_CPUS=8
TEXT_PROPOSER_MEMORY=16g
TEXT_RESULTS_ROOT=$RUN/results
TEXT_TEST_DATA_ROOT=$RUN/test-data
TEXT_CLASSIFICATION_LLM_CACHE_DIR=$RUN/llm-cache

# Optional.
# TEXT_PROPOSER_MODEL=claude-opus-5
# TEXT_FINALIZE_WORKERS=3     systems evaluated concurrently during --test
